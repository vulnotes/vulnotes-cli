services:
  nginx:
    image: nginx:alpine
    container_name: vulnotes-nginx
    restart: always
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
    ports:
      - "{{BIND_ADDRESS}}:{{HTTP_PORT}}:80"
    depends_on:
      - backend
      - frontend
      - mcp
    networks:
      - vulnotes-network
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETUID
      - SETGID
      - NET_BIND_SERVICE

  mongodb:
    image: mongo:latest
    container_name: vulnotes-mongodb
    restart: always
    volumes:
      - mongodb_data:/data/db
      - mongodb_config:/data/configdb
    networks:
      - vulnotes-network
    healthcheck:
      test: ["CMD", "mongosh", "--eval", "db.adminCommand('ping')"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s

  puppeteer:
    image: registry.vulnotes.com/vulnotes-app/puppeteer:latest
    container_name: vulnotes-puppeteer
    restart: always
    environment:
      - NODE_ENV=production
      - PORT=3001
      - PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
      - PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
      - PUPPETEER_SERVICE_TOKEN=${PUPPETEER_SERVICE_TOKEN}
      - DOCX_RENDER_FRONTEND_URL=http://frontend:3000
    networks:
      - vulnotes-network
    healthcheck:
      test: ["CMD", "node", "-e", "const http = require('http'); const req = http.request({host: 'localhost', port: 3001, path: '/health', timeout: 3000}, (res) => process.exit(res.statusCode === 200 ? 0 : 1)); req.on('error', () => process.exit(1)); req.end();"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    tmpfs:
      - /tmp:size=512m
      - /home/puppeteer/.cache:size=128m
    shm_size: '2gb'
    security_opt:
      - no-new-privileges:true

  backend:
    image: registry.vulnotes.com/vulnotes-app/backend:latest
    container_name: vulnotes-backend
    restart: always
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      - NODE_ENV=production
      - STRICT_LICENSE_MODE=true
      - PUPPETEER_SERVICE_URL=http://puppeteer:3001
      - PUPPETEER_SERVICE_TOKEN=${PUPPETEER_SERVICE_TOKEN}
      - LICENSE_FILE_PATH=/app/license/license.json
      - MONGO_URI=mongodb://mongodb:27017/vulnotes
      - JWT_SECRET=${JWT_SECRET}
      - CLIENT_URL=${DOMAIN}
      - API_URL=${DOMAIN}/api
      - BACKRONAUT_SECRET=${BACKRONAUT_SECRET}
      - SUPPORT_API_TOKEN=${SUPPORT_API_TOKEN}
    volumes:
      - ./license.json:/app/license/license.json:ro
      - backend_uploads:/app/uploads
      - backend_logs:/app/logs
      - license_cache:/app/license/.cache
    depends_on:
      - mongodb
      - puppeteer
    networks:
      - vulnotes-network
    tmpfs:
      - /tmp:size=256m
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETUID
      - SETGID

  frontend:
    image: registry.vulnotes.com/vulnotes-app/frontend:latest
    container_name: vulnotes-frontend
    restart: always
    environment:
      - NODE_ENV=production
      - NEXT_PUBLIC_API_URL=/api
      - NEXT_PUBLIC_BACKEND_URL=${DOMAIN}
      - BACKEND_URL=http://backend:5000/api
      - BACKEND_INTERNAL_URL=http://backend:5000/api
      - NEXT_PUBLIC_SUPPORT_URL=https://support.vulnotes.com
    depends_on:
      - backend
    networks:
      - vulnotes-network
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

  mcp:
    image: registry.vulnotes.com/vulnotes-app/mcp-server:latest
    container_name: vulnotes-mcp
    restart: always
    environment:
      - NODE_ENV=production
      - VULNOTES_API_URL=http://backend:5000
      - PORT=3000
    depends_on:
      - backend
    networks:
      - vulnotes-network
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:3000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

volumes:
  mongodb_data:
    driver: local
  mongodb_config:
    driver: local
  backend_uploads:
    driver: local
  backend_logs:
    driver: local
  license_cache:
    driver: local

networks:
  vulnotes-network:
    driver: bridge
