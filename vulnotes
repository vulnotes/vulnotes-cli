#!/usr/bin/env bash
#
# Vulnotes CLI - Manage on-prem Vulnotes deployments
# Usage: vulnotes <command> [options]
#

set -euo pipefail

# Resolve symlinks so an installed launcher can find its adjacent lib/ directory.
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    LINK_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" == /* ]] || SCRIPT_PATH="$LINK_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"

# Source all library files
source "$SCRIPT_DIR/lib/config.sh"
source "$SCRIPT_DIR/lib/utils.sh"
source "$SCRIPT_DIR/lib/templates.sh"
source "$SCRIPT_DIR/lib/commands/init.sh"
source "$SCRIPT_DIR/lib/commands/lifecycle.sh"
source "$SCRIPT_DIR/lib/commands/backup.sh"
source "$SCRIPT_DIR/lib/commands/reset.sh"
source "$SCRIPT_DIR/lib/commands/logs.sh"
source "$SCRIPT_DIR/lib/commands/help.sh"

# Main entry point
main() {
    check_dependencies
    check_cli_update

    local command="${1:-help}"
    shift || true

    case "$command" in
        init)
            cmd_init "$@"
            ;;
        start)
            cmd_start "$@"
            ;;
        stop)
            cmd_stop "$@"
            ;;
        restart)
            cmd_restart "$@"
            ;;
        update)
            cmd_update "$@"
            ;;
        reset)
            cmd_reset "$@"
            ;;
        logs)
            cmd_logs "$@"
            ;;
        backup)
            cmd_backup "$@"
            ;;
        backup-rotate)
            cmd_backup_rotate "$@"
            ;;
        backup-schedule)
            cmd_backup_schedule "$@"
            ;;
        restore)
            cmd_restore "$@"
            ;;
        help|--help|-h)
            cmd_help
            ;;
        version|--version|-v)
            cmd_version
            ;;
        *)
            log_error "Unknown command: $command"
            echo
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
